TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_ACCESS_TOKEN=
TWITCH_BOT_REFRESH_TOKEN=
TWITCH_BOT_USER_ID=
DISCORD_LISTNER_NOTIFY_WEBHOOK_URL=
DISCORD_BROADCASTER_NOTIFY_WEBHOOK_URL=
DISCORD_BROADCASTER_NOTIFY_WEBHOOK_USER_ID=
# USER_ID と同じ配列位置（カンマ区切り）で通知に使う名前を上書きする。空欄はTwitch表示名を使用。
