CSV_PATH=/path/to/your/twicome/data/honban/targetusers.csv
DATABASE_PATH=./data/iruyo.db
# Cloudflare Access のJWTを検証する場合に両方を設定する。両方空欄なら検証しない。
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
